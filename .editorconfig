# Two-space, space-indented everywhere — see .vscode/settings.json for why the
# indent-rainbow error colour is disabled alongside this.
root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
insert_final_newline = true

# npm wrote this one at four; left alone so `npm install` doesn't reflow it.
[package.json]
indent_size = 4
